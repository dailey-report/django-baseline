root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 94

# blank context lines in a patch are a single space; trimming them breaks the patch
[*.patch]
trim_trailing_whitespace = false
