" Autocommands
""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
"autocmd BufEnter * :syntax sync fromstart " ensure every file does syntax highlighting (full)

"spell check for text files
autocmd BufRead *.txt setlocal spell spelllang=en_us textwidth=80 formatoptions+=tanl
"prevent spell check from highlighting words that are not capitalized (not working!)
syn match myExCapitalWords +\<\w*[A-Z]\K*\>+ contains=@NoSpell
" alternatively, and more lienient:
"syn match myExCapitalWords +\<\w*[A-Z]\K*\>\|'s+ contains=@NoSpell
" change highlight color to be more gentle
hi SpellBad ctermbg=017


""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" MikeD mappings
"   http://vimdoc.sourceforge.net/htmldoc/usr_40.html#40.1
""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" change quote to apostrophe
map <F2> :s/"/'/g<CR>:noh<CR>
" change apostrophe to quote
map <F3> :s/'/"/g<CR>:noh<CR>
" force redraw of screen (b/c i think terminator is re-mapping CTRL-L)
map <F5> :redraw!<CR>
" replace current word with unnamed paste register
nmap <silent> cp "_cw<C-R>"<Esc>
"split navigations
nnoremap <C-J> <C-W><C-J>
nnoremap <C-K> <C-W><C-K>
nnoremap <C-L> <C-W><C-L>
nnoremap <C-H> <C-W><C-H>


