# required environment variables for container run
#
# copy to top level directory as '.env' and modify for your setup

# Development mode
IS_DEV=true
ALLOWED_HOSTS=0.0.0.0,127.0.0.1,localhost

# Extra CORS origins allowed to call the API (comma-separated)
CORS_EXTRA_ORIGINS=

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_DB=baseline
POSTGRES_USER=baseline
POSTGRES_PASSWORD=generate_random_password_here

# Celery broker
RABBITMQ_USER=baseline
RABBITMQ_PASSWORD=generate_random_password_here

# Redis (celery results, cache); empty is fine only while redis stays on the container network
REDIS_PASSWORD=

# Django secret key (generate with: python -c 'from django.core.management.utils import \
# get_random_secret_key; print(get_random_secret_key())')
DJANGO_SECRET_KEY='your-secret-key-here'

# Django superuser (created automatically on first container start if set)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=please-change-this-password

# Container user/group (should match host user for correct file permissions)
# Run: id -u && id -g
CONTAINER_UID=1000
CONTAINER_GID=1000
