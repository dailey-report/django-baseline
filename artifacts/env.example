# required environment variables for container run
#
# copy to top level directory as '.env' and modify for your setup

# Development mode
IS_DEV=true
ALLOWED_HOSTS=0.0.0.0,127.0.0.1,localhost

# Database
POSTGRES_HOST=postgres
POSTGRES_CONN_MAX_AGE=60
POSTGRES_DB=baseline
POSTGRES_USER=baseline
POSTGRES_PASSWORD=generate_random_password_here

# Django secret key (generate with: python -c 'from django.core.management.utils import \
# get_random_secret_key; print(get_random_secret_key())')
DJANGO_SECRET_KEY='your-secret-key-here'

# Django security
CSRF_COOKIE_SECURE = False
SESSION_COOKIE_SECURE = False
# Django superuser credentials
DJANGO_SUPERUSER_EMAIL=root@localhost
DJANGO_SUPERUSER_PASSWORD=please-change-this-password

# Container user/group (should match host user for file permissions)
