+# Logging
+#
+# Development logs to console and a file per service. Production logs JSON to console only:
+# the container runtime is the collector, and a file inside a container is invisible to it.
+#
+# Identifiers, not identities: log a user by primary key at INFO and above; the email address
+# belongs at DEBUG only, since INFO-level logs are the ones shipped and retained.
+
+# this can be parsed with dateutil.parser.isoparse()
+TIMESTAMP = '{asctime}.{msecs:03.0f}'
+FORMAT = TIMESTAMP + ' [{levelname}] {name}:{lineno} [{request_id}] {message}'
+
+# one file per service: they share /opt/app/logs and a single path interleaves them
+LOG_FILE = environment('LOG_FILE', default='/opt/app/logs/baseline.log')
+
+_APP_LOG_LEVEL = 'DEBUG' if IS_DEV else 'INFO'
+_LOG_HANDLERS = ['console'] + (['file'] if IS_DEV else [])
+
+LOGGING = {
+    'version': 1,
+    'disable_existing_loggers': False,
+    'filters': {
+        'request_id': {'()': 'core.logging.RequestIdFilter'},
+    },
+    'formatters': {
+        'verbose': {
+            'format': FORMAT,
+            'datefmt': '%Y-%m-%dT%H:%M:%S',
+            'style': '{',
+        },
+        'json': {'()': 'core.logging.JsonFormatter'},
+    },
+    'handlers': {
+        'console': {
+            'class': 'logging.StreamHandler',
+            'formatter': 'verbose' if IS_DEV else 'json',
+            'filters': ['request_id'],
+        },
+        'file': {
+            'level': 'DEBUG',
+            'class': 'logging.FileHandler',
+            'formatter': 'verbose',
+            'filters': ['request_id'],
+            'filename': LOG_FILE,
+        },
+    },
+    'loggers': {
+        'django': {
+            'handlers': _LOG_HANDLERS,
+            'level': 'WARNING',
+            'propagate': True,
+        },
+        # define loggers per app
+        **{
+            app: {
+                'handlers': _LOG_HANDLERS,
+                'level': _APP_LOG_LEVEL,
+                'propagate': True,
+            }
+            for app in ('core',)
+        },
+    },
+}
+
+# FileHandler opens its file on construction, so it must not exist outside development
+if not IS_DEV:
+    del LOGGING['handlers']['file']
+
+TEST_RUNNER = 'core.runner.QuietTestRunner'
+
+
+# REST API (Django REST Framework + drf-spectacular + drf-standardized-errors)
